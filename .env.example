# Public Supabase credentials for client-side queries (safe for public exposure)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Event Identifier (matches the server event_id)
VITE_EVENT_ID=biniyog-adda-2026-11-14

# Server / Edge Function elevated service role key (NEVER expose to frontend, only for migrations / backend endpoints)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
